+    function renderizarTabelaPlantas() {
+      const tbody = document.getElementById("tb-plantas");
+      if (!tbody) return;
+      if (!listaPlantasCache.length) {
+        tbody.innerHTML = '<tr><td colspan="4" class="estado-vazio">Nenhuma planta cadastrada.</td></tr>';
+        return;
+      }
+
+      tbody.innerHTML = listaPlantasCache.map(p => `
+        <tr data-id="${p.id}">
