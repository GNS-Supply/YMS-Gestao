+            </button>
+          </td>
+        </tr>
+      `).join("");
+
+      tbody.querySelectorAll(".btn-toggle-planta").forEach(btn => {
+        btn.addEventListener("click", async () => {
+          const id = btn.dataset.id;
+          const ativaAtual = btn.dataset.ativa === "true";
+          btn.disabled = true;
+          try {
+            await alternarAtivaPlanta(db, id, !ativaAtual);
+            mostrarToast(`Planta ${ativaAtual ? "desativada" : "ativada"}.`, { tipo: "sucesso" });
+            await carregarPlantas();
+          } catch (err) {
+            console.error("Erro ao alterar status da planta:", err);
+            await mostrarAlerta("Erro ao alterar o status da planta: " + err.message, { titulo: "Erro", tipo: "erro" });
+            btn.disabled = false;
+          }
+        });
+      });
